# Copia este archivo a .env (o define las variables en tu hosting)
PORT=3000
# Credenciales iniciales del dashboard (solo se usan si aún no existe ningún usuario)
ADMIN_USER=icca
ADMIN_PASSWORD=cambia-esta-clave-123
# Opcional: clave para firmar sesiones. Si no la pones, se genera sola en data/.secret
# SESSION_SECRET=
# En producción (HTTPS) pon:
# NODE_ENV=production
